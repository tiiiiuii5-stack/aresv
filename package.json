    "test:evidence-coverage": "tsx scripts/validate-evidence-coverage-gate.ts",
    "test:full-repo-coverage": "tsx scripts/validate-full-repo-coverage.ts",
    "test:public-github-coverage": "tsx scripts/validate-public-github-full-coverage.ts",
    "test:full-flow": "tsx scripts/validate-product-flow-contract.ts",
    "test:enterprise-readiness": "tsx scripts/validate-enterprise-readiness.ts",
    "test:intelligence-precision": "tsx scripts/validate-intelligence-precision.ts",
    "test:scan-evolution": "tsx scripts/validate-scan-evolution-loop.ts",
    "test:github-integration": "tsx scripts/validate-github-integration.ts",
    "test:appraisal-engine": "tsx scripts/validate-appraisal-engine.ts",
    "test:scan-assurance": "tsx scripts/validate-scan-assurance.ts",
    "test:trust-ledger": "tsx scripts/validate-trust-ledger.ts",
    "test:transparency-log": "tsx scripts/validate-transparency-log.ts",
    "test:transparency-proofs": "tsx scripts/validate-transparency-proofs.ts",
    "test:control-plane": "tsx scripts/validate-control-plane.ts",
    "test:pipeline": "tsx scripts/validate-pipeline.ts",
    "test:replay": "tsx scripts/validate-replay-engine.ts",
    "test:trust-graph": "tsx scripts/validate-trust-graph.ts",
    "test:report-language": "tsx scripts/validate-report-language.ts",
    "test:passport-pipeline": "tsx scripts/validate-passport-prompt-pipeline.ts",
    "test:evidence-ops": "tsx scripts/validate-evidence-ops.ts",
    "test:certificates": "tsx scripts/validate-certificates.ts",
    "anchor:publish": "tsx scripts/publish-transparency-anchor.ts",
    "env:bootstrap": "tsx scripts/bootstrap-production-secrets.ts",
    "env:production": "tsx scripts/validate-production-env.ts",
    "smoke:appraisal-certificate": "tsx scripts/smoke-appraisal-certificate-flow.ts",
    "db:studio": "prisma studio",
    "admin:create": "node scripts/create-admin-accounts.mjs",
    "admin:founder": "tsx scripts/grant-founder-access.ts",
    "clean": "node scripts/clean.mjs",
    "reset": "node scripts/clean.mjs --reset",
    "test:gen": "node -e \"console.log('Test generation endpoint')\"",
    "smoke:v0.2": "node scripts/v02-smoke.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.3",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-zoom-pan-pinch": "^4.0.3",
    "stripe": "^22.2.0",
    "three": "^0.184.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@types/ws": "8.5.12",
    "autoprefixer": "10.4.19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "prisma": "^7.8.0",
    "tailwindcss": "3.4.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.2.6"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13"
  }
