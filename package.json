{
  "name": "local-ai-app-builder",
  "version": "2.0.0",
  "private": true,
  "description": "10-year ahead autonomous AI software development platform with auto-healing and real-time streaming",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "npm run dev:frontend",
    "dev:frontend": "next dev -p 3002 --webpack",
    "dev:backend": "node backend/server.mjs",
    "build": "npm run type-check && next build --webpack",
    "start": "npm run start:frontend",
    "start:frontend": "next start -p 3002",
    "start:backend": "node backend/server.mjs",
    "worker:build": "tsx scripts/build-worker.ts",
    "worker:github": "tsx scripts/github-scan-worker.ts",
    "lint": "eslint . --max-warnings=0",
    "pretype-check": "node scripts/ensure-next-routes-shim.mjs",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/seed-persistence.mjs",
    "db:seed:integrations": "tsx scripts/seed-integration-modules.ts",
    "test:integrations": "tsx scripts/validate-integration-modules.ts",
    "test:booking-domain": "tsx scripts/validate-booking-domain.ts",
    "test:project-diff": "tsx scripts/validate-historical-diff.ts",
    "test:closed-loop": "tsx scripts/validate-closed-loop.ts",
