# Production required: set at least one.
GOOGLE_API_KEY=
GEMINI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://flqnzxbgvbrctqztkapj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase / Prisma
# DATABASE_URL is pooled and used by app runtime/serverless functions.
DATABASE_URL="postgresql://postgres.flqnzxbgvbrctqztkapj:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
# DIRECT_URL is non-pooled and used by Prisma migrations.
DIRECT_URL="postgresql://postgres.flqnzxbgvbrctqztkapj:[PASSWORD]@db.flqnzxbgvbrctqztkapj.supabase.co:5432/postgres"
REDIS_URL=redis://...
BULLMQ_CONCURRENCY=5
# Production required secrets.
NEXTAUTH_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
AGENT_MEMORY_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@ventureos.local
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
INTELLIGENCE_API_JWT_SECRET=
VENTUREOS_CERT_PRIVATE_KEY_BASE64=
VENTUREOS_CERT_PUBLIC_KEY_BASE64=
VENTUREOS_CERT_SIGNING_KEY_ID=
VENTUREOS_INTELLIGENCE_API_URL=
VENTUREOS_INTELLIGENCE_API_KEY=
VENTUREOS_SCAN_BLOCK_THRESHOLD=75

# Optional external evidence sources for appraisals/scans.
# Public advisory enrichment works without tokens but tokens improve rate limits.
VENTUREOS_EXTERNAL_INTELLIGENCE=enabled
GITHUB_TOKEN=
NVD_API_KEY=
# These must point at real internal/proprietary source services before VentureOS will claim them.
VENTUREOS_BENCHMARK_DATASET_URL=
VENTUREOS_REPOSITORY_CORPUS_URL=
VENTUREOS_RUNTIME_TELEMETRY_URL=
VENTUREOS_VALUATION_DATASET_URL=

# Optional external transparency anchoring.
# GitHub anchoring commits signed anchor manifests into an external repository.
TRANSPARENCY_ANCHOR_GITHUB_TOKEN=
TRANSPARENCY_ANCHOR_GITHUB_REPOSITORY=
TRANSPARENCY_ANCHOR_GITHUB_BRANCH=main
TRANSPARENCY_ANCHOR_GITHUB_PATH_PREFIX=.ventureos/transparency-anchors
# Witness anchoring posts signed anchor manifests to an independent external log.
TRANSPARENCY_ANCHOR_WITNESS_URL=
TRANSPARENCY_ANCHOR_WITNESS_URLS=
TRANSPARENCY_ANCHOR_WITNESS_TOKEN=
# Minimum independent witnesses required before VentureOS reports witness policy satisfied.
TRANSPARENCY_MIN_INDEPENDENT_WITNESSES=2
# Optional Sigstore/Rekor-compatible log endpoint. Prefer a configured shard URL or internal Rekor service.
TRANSPARENCY_ANCHOR_REKOR_URL=
TRANSPARENCY_ANCHOR_REKOR_TOKEN=
# Optional RFC 3161 Time Stamping Authority endpoint.
TRANSPARENCY_ANCHOR_TSA_URL=
# Optional redundancy only. This should point at a service that records anchor hashes and returns transaction evidence.
TRANSPARENCY_ANCHOR_BLOCKCHAIN_URL=
TRANSPARENCY_ANCHOR_BLOCKCHAIN_TOKEN=

AGENT_MEMORY_MAX_PER_USER=1000
AGENT_MEMORY_PRUNE_DAYS=90
AGENT_MEMORY_SIMILARITY_THRESHOLD=0.75
AGENT_MEMORY_EMBEDDING_MODEL=text-embedding-004

# Build Mutation
MUTATION_MAX_PER_JOB=3
MUTATION_SIMILARITY_THRESHOLD=0.80
MUTATION_TEMP_MIN=0.7
MUTATION_TEMP_MAX=1.0

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_APPRAISAL_INSTANT=
STRIPE_PRICE_APPRAISAL_BUYER=
APP_URL=http://localhost:3002
APP_URL_ALLOWLIST=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3002
