{
  "events": [
    {
      "name": "CreatorCreateOffer",
      "trigger": "Launch offer",
      "payload": {
        "target": "Offer",
        "result": "Adds paid offer to launch board",
        "timestamp": "ISO-8601"
      },
      "sideEffects": [
        "append record",
        "prepend audit event"
      ]
    },
    {
      "name": "CreatorTransitionPurchase",
      "trigger": "Convert subscriber",
      "payload": {
        "target": "Purchase",
        "result": "Moves Interested -> Purchased -> Retained",
        "timestamp": "ISO-8601"
      },
      "sideEffects": [
        "update record status",
        "prepend audit event"
      ]
    },
    {
      "name": "CreatorDeleteSubscriber",
      "trigger": "Cancel subscriber",
      "payload": {
        "target": "Subscriber",
        "result": "Marks subscriber inactive",
        "timestamp": "ISO-8601"
      },
      "sideEffects": [
        "remove record and dependents",
        "prepend audit event"
      ]
    }
  ],
  "delivery": "in-process runtime event log plus API response payload"
}