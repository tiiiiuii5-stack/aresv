generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Offer {
  id        String   @id @default(cuid())
  title String
  price String
  tier String
  conversionRate String
  status String
  Purchase Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email String
  tier String
  lifetimeValue String
  risk String
  joinedAt String
  Purchase Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id        String   @id @default(cuid())
  offerId String
  subscriberId String
  amount String
  status String


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
