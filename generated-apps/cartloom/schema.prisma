generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String   @id @default(cuid())
  title String
  price String
  inventory String
  category String
  rating String
  CartItem CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id        String   @id @default(cuid())
  items String
  customerEmail String
  total String
  status String
  CartItem CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  productId String
  orderId String
  quantity String
  price String


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
